{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kb-hud",
  "version": "0.1.0",
  "identifier": "com.wochap.kb-hud",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "kb-hud overlay",
        "width": 640,
        "height": 320,
        "transparent": true,
        "decorations": false,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "settings",
        "title": "kb-hud settings",
        "width": 760,
        "height": 680,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
