{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the overlay and settings windows",
  "windows": ["overlay", "settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-size",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
